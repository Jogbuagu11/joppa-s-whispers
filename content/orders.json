    ],
    "rewards": {
      "talents": 15,
      "blessings": 2
    },
    "text": "An oil lamp and a clay lamp for the elder's window! It's all dark and I don't like it dark.",
    "scene_id": null
  },
  {
    "id": "ch2_o_003",
    "chapter": 2,
    "character_id": "amos",
    "kind": "spiritual",
    "items": [
      {
        "item_id": "fruit_03",
        "count": 1
      }
    ],
    "rewards": {
      "talents": 15,
      "blessings": 2
    },
    "text": "Well now. The fever I can bear, child. It's the flock scattering that robs my sleep. A little peace.",
    "scene_id": null
  },
  {
    "id": "ch2_o_004",
    "chapter": 2,
    "character_id": "naomi",
    "kind": "literal",
    "items": [
